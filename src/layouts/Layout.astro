---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SupportFab from '../components/SupportFab.astro';
import VercelAnalytics from '../components/VercelAnalytics.astro';
import VercelSpeedInsights from '../components/VercelSpeedInsights.astro';
import { type Language, langLocale, ogLocale, allLangs } from '../lib/slugs';

interface Props {
	title: string;
	description: string;
	lang: Language;
	alternates?: Record<Language, string>;
	keywords?: string[];
	noindex?: boolean;
}

const { title, description, lang, alternates, keywords = [], noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const defaultKeywords = [
	"online tools", "ferramentas online", "privacy", "privacidade", 
	"local processing", "processamento local", "web utilities", "utilitarios web",
	"pwa", "offline", "converter", "compressor", "editor"
];

const allKeywords = [...new Set([...defaultKeywords, ...keywords])].join(", ");

const getBasePath = (pathname: string) => {
  const parts = pathname.split('/').filter(Boolean);
  if (parts.length > 0 && allLangs.includes(parts[0] as Language)) {
    return '/' + parts.slice(1).join('/');
  }
  return pathname;
};

const basePath = getBasePath(Astro.url.pathname);

	const skipText: Record<Language, string> = {
		en: 'Skip to content',
		pt: 'Pular para o conteúdo',
		es: 'Saltar al contenido',
		fr: 'Passer au contenu',
		de: 'Zum Inhalt springen',
		ru: 'Перейти к содержанию',
	};
---
<!doctype html>
<html lang={langLocale[lang]}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark light" />
		<meta name="google-site-verification" content="1RTffR8nOmJXM4zANfuZp4wVtcRpKgrJGJw0VPlNOq0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="192x192" href="/static/images/icon-192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/static/images/slit_preto.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/static/images/icon-192.png" />
		<link rel="manifest" href="/manifest.json" />
		<link rel="dns-prefetch" href="https://vercel.speed-insights.com" />
		<link rel="dns-prefetch" href="https://va.vercel-scripts.com" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
		

		<script is:inline>
			// Register Service Worker
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(() => {});
				});
			}

			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}

			const handleToggleClick = () => {
				const element = document.documentElement;
				element.classList.toggle("dark");

				const isDark = element.classList.contains("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
			};

			document.addEventListener("click", (e) => {
				if (e.target.closest(".theme-toggle-btn")) {
					handleToggleClick();
				}
			});
		</script>
		
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={allKeywords} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta property="og:site_name" content="SLIT.IO" />
		<meta property="og:locale" content={ogLocale[lang]} />
		
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />
		<meta name="twitter:site" content="@slitio" />

		

		{allLangs.map(l => (
			<link rel="alternate" hreflang={langLocale[l]} href={
				alternates && alternates[l]
					? new URL(alternates[l], Astro.site)
					: new URL(`${l}${basePath}`, Astro.site)
			} />
		))}
		<link rel="alternate" hreflang="x-default" href={
			alternates && alternates.en
				? new URL(alternates.en, Astro.site)
				: new URL(`en${basePath}`, Astro.site)
		} />

		{/* Vercel Monitoring */}
		<VercelAnalytics />
		<VercelSpeedInsights />
	</head>
	<body class="bg-gray-50 font-sans text-gray-900 dark:bg-gray-900 dark:text-gray-100">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-0 focus:left-0 focus:p-4 focus:bg-white focus:text-purple-600 focus:font-bold focus:ring-2 focus:ring-purple-500">
			{skipText[lang]}
		</a>
		<Header lang={lang} /> {/* Passa o idioma para o Header */}
		<main id="main-content" class="container mx-auto px-6 py-8 min-h-screen">
			<slot />
		</main>
		<Footer lang={lang} />
		<SupportFab lang={lang} />
	</body>
</html>
