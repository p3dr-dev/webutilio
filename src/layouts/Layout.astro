---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VercelAnalytics from '../components/VercelAnalytics.astro';
import VercelSpeedInsights from '../components/VercelSpeedInsights.astro';

interface Props {
	title: string;
	description: string;
	lang: 'pt' | 'en';
	alternates?: {
		pt: string;
		en: string;
	};
	keywords?: string[];
}

const { title, description, lang, alternates, keywords = [] } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const defaultKeywords = [
	"online tools", "ferramentas online", "privacy", "privacidade", 
	"local processing", "processamento local", "web utilities", "utilitarios web",
	"pwa", "offline", "converter", "compressor", "editor"
];

const allKeywords = [...new Set([...defaultKeywords, ...keywords])].join(", ");

// Helper para obter o caminho base sem o idioma
const getBasePath = (pathname: string) => {
  const parts = pathname.split('/').filter(Boolean); // Remove partes vazias
  if (parts.length > 0 && (parts[0] === 'en' || parts[0] === 'pt')) {
    return '/' + parts.slice(1).join('/');
  }
  return pathname;
};

const basePath = getBasePath(Astro.url.pathname);

const ptAlternate = alternates ? new URL(alternates.pt, Astro.site) : new URL('pt' + basePath, Astro.site);
const enAlternate = alternates ? new URL(alternates.en, Astro.site) : new URL('en' + basePath, Astro.site);
---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en-US'}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="google-site-verification" content="1RTffR8nOmJXM4zANfuZp4wVtcRpKgrJGJw0VPlNOq0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="512x512" href="/static/images/slit_preto.png" />
		<link rel="apple-touch-icon" href="/static/images/slit_preto.png" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#111827" media="(prefers-color-scheme: dark)" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		

		<script is:inline>
			// Register Service Worker
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(() => {});
				});
			}

			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();

			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}

			const handleToggleClick = () => {
				const element = document.documentElement;
				element.classList.toggle("dark");

				const isDark = element.classList.contains("dark");
				localStorage.setItem("theme", isDark ? "dark" : "light");
			};

			document.addEventListener("click", (e) => {
				if (e.target.closest(".theme-toggle-btn")) {
					handleToggleClick();
				}
			});
		</script>
		
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={allKeywords} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={new URL('/og-image.png', Astro.site)} /> {/* Crie uma imagem de 1200x630px em public/ */}
		
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

		

		<link rel="alternate" hreflang="pt-BR" href={ptAlternate} />
		<link rel="alternate" hreflang="en-US" href={enAlternate} />
		<link rel="alternate" hreflang="x-default" href={ptAlternate} />

		{/* Vercel Monitoring */}
		<VercelAnalytics />
		<VercelSpeedInsights />
	</head>
	<body class="bg-gray-50 font-sans text-gray-900 dark:bg-gray-900 dark:text-gray-100">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-0 focus:left-0 focus:p-4 focus:bg-white focus:text-purple-600 focus:font-bold focus:ring-2 focus:ring-purple-500">
			{lang === 'pt' ? 'Pular para o conteúdo' : 'Skip to content'}
		</a>
		<Header lang={lang} /> {/* Passa o idioma para o Header */}
		<main id="main-content" class="container mx-auto px-6 py-8 min-h-screen">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
