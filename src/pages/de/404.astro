---
import Layout from '../../layouts/Layout.astro';
import de from '../../i18n/de.json';
---

<Layout title={de.notFound.title} description={de.notFound.description} lang="de" noindex={true}>
  <section class="container mx-auto px-6 py-20 text-center">
    <h1 class="text-6xl font-extrabold text-purple-600 mb-4">{de.notFound.heading}</h1>
    <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">{de.notFound.message}</p>
    <a href="/de/" class="inline-block bg-purple-600 text-white font-bold py-3 px-6 rounded-md hover:bg-purple-700 transition-colors">
      {de.notFound.backHome}
    </a>
  </section>
</Layout>
