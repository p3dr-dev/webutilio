---
import Layout from '../../layouts/Layout.astro';
import fr from '../../i18n/fr.json';
---

<Layout title={fr.notFound.title} description={fr.notFound.description} lang="fr" noindex={true}>
  <section class="container mx-auto px-6 py-20 text-center">
    <h1 class="text-6xl font-extrabold text-purple-600 mb-4">{fr.notFound.heading}</h1>
    <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">{fr.notFound.message}</p>
    <a href="/fr/" class="inline-block bg-purple-600 text-white font-bold py-3 px-6 rounded-md hover:bg-purple-700 transition-colors">
      {fr.notFound.backHome}
    </a>
  </section>
</Layout>
