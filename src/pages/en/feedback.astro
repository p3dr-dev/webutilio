---
import Layout from '../../layouts/Layout.astro';
import FeedbackForm from '../../components/FeedbackForm';
import { useTranslations } from '../../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout title={`Feedback - SLIT.IO`} description={t('site.description')} lang={lang}>
  <section class="container mx-auto px-6 py-12 text-center">
    <h1 class="text-4xl font-bold text-gray-800 dark:text-white mb-6">{t('feedbackPage.title')}</h1>
    <p class="max-w-3xl mx-auto text-lg text-gray-600 dark:text-gray-300 mb-12">
      {t('feedbackPage.description')}
    </p>

    <div class="max-w-2xl mx-auto">
      <FeedbackForm client:load lang="en" />
    </div>

    <p class="mt-12 text-gray-500 dark:text-gray-400">
      {t('feedbackPage.thanks')}
    </p>
  </section>
</Layout>
