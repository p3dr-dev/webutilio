---
import Layout from '../../layouts/Layout.astro';
import en from '../../i18n/en.json';
---

<Layout title={en.notFound.title} description={en.notFound.description} lang="en" noindex={true}>
  <section class="container mx-auto px-6 py-20 text-center">
    <h1 class="text-6xl font-extrabold text-purple-600 mb-4">{en.notFound.heading}</h1>
    <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">{en.notFound.message}</p>
    <a href="/en/" class="inline-block bg-purple-600 text-white font-bold py-3 px-6 rounded-md hover:bg-purple-700 transition-colors">
      {en.notFound.backHome}
    </a>
  </section>
</Layout>
