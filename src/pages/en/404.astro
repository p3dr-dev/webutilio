---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Page Not Found - SLIT.IO" description="The page you are looking for does not exist." lang="en">
  <section class="container mx-auto px-6 py-20 text-center">
    <h1 class="text-6xl font-extrabold text-purple-600 mb-4">404</h1>
    <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">Page not found.</p>
    <a href="/en/" class="inline-block bg-purple-600 text-white font-bold py-3 px-6 rounded-md hover:bg-purple-700 transition-colors">
      Back to home
    </a>
  </section>
</Layout>
