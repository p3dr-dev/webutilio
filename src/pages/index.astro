---
// Redirecionamento de idioma ultra-rápido e resiliente
---
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SLIT.IO - Redirecionando / Redirecting</title>
    
    <!-- Redirecionamento instantâneo via JS -->
    <script is:inline>
        (function() {
            const userLang = navigator.language || navigator.userLanguage;
            const targetLang = userLang.toLowerCase().startsWith('en') ? 'en' : 'pt';
            window.location.replace('/' + targetLang + '/');
        })();
    </script>

    <!-- Fallback caso o JS falhe (redireciona para PT após 2 segundos) -->
    <meta http-equiv="refresh" content="2;url=/pt/">

    <style>
        body {
            font-family: system-ui, -apple-system, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            background-color: #f9fafb;
            color: #111827;
        }
        .container { text-align: center; padding: 2rem; }
        .spinner {
            width: 40px; height: 40px;
            border: 4px solid #f3f3f3;
            border-top: 4px solid #9333ea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 1.5rem;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .links { margin-top: 1.5rem; display: flex; gap: 1rem; justify-content: center; }
        a { color: #9333ea; text-decoration: none; font-weight: bold; }
        a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <div class="container">
        <div class="spinner"></div>
        <p>Escolha seu idioma / Choose your language:</p>
        <div class="links">
            <a href="/pt/">Português (Brasil)</a>
            <a href="/en/">English</a>
        </div>
    </div>
</body>
</html>