---
import type { Tool, Language } from '../data/tools';
import { useTranslations } from '../i18n/utils';

interface Props {
  tool: Tool;
  lang: Language;
}

const { tool, lang } = Astro.props;
const t = useTranslations(lang);

const title = t(`tools.${tool.id}.title`);
const description = t(`tools.${tool.id}.description`);
const category = t(`categories.${tool.category}`);
const slug = tool.slugs[lang];
const basePath = lang === 'en' ? 'tools' : 'ferramentas';
---
<a
  href={`/${lang}/${basePath}/${slug}`}
  class="group relative flex h-64 flex-col justify-between overflow-hidden rounded-2xl border border-gray-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-purple-200 hover:shadow-xl dark:border-gray-800 dark:bg-gray-800 dark:hover:border-purple-900/50"
>
  <div class="relative z-10">
    <div class="mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-purple-50 text-3xl transition-colors group-hover:bg-purple-100 dark:bg-purple-900/20 dark:group-hover:bg-purple-900/40">
      {tool.icon}
    </div>
    <h3 class="mb-2 text-xl font-bold text-gray-800 transition-colors group-hover:text-purple-600 dark:text-gray-100 dark:group-hover:text-purple-400">
      {title}
    </h3>
    <p class="line-clamp-3 text-sm leading-relaxed text-gray-500 transition-colors group-hover:text-gray-600 dark:text-gray-400 dark:group-hover:text-gray-300">
      {description}
    </p>
  </div>

  <div class="relative z-10 flex items-center justify-between border-t border-gray-50 pt-4 dark:border-gray-700/50">
    <span class="text-xs font-bold uppercase tracking-wider text-purple-500/80">
      {category}
    </span>
    <span class="rounded-full bg-gray-50 p-1 text-gray-400 transition-all group-hover:bg-purple-600 group-hover:text-white dark:bg-gray-700/50">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </span>
  </div>

  {/* Background Decorative Element */}
  <div class="absolute -right-4 -top-4 h-24 w-24 rounded-full bg-purple-50/50 transition-transform duration-500 group-hover:scale-150 dark:bg-purple-900/10"></div>
</a>
