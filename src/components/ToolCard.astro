---
import type { Tool, Language } from '../data/tools';
import { useTranslations } from '../i18n/utils';
import { toolBasePath } from '../lib/slugs';

interface Props {
  tool: Tool;
  lang: Language;
}

const { tool, lang } = Astro.props;
const t = useTranslations(lang);

const title = t(`tools.${tool.id}.title`);
const description = t(`tools.${tool.id}.description`);
const category = t(`categories.${tool.category}`);
const slug = tool.slugs[lang];
const basePath = toolBasePath[lang];

// Combine title, description, and specific keywords for search
const searchTerms = [
  title, 
  description, 
  ...(tool.keywords || []),
  t(`tools.${tool.id}.keywords`)
].join(' ').toLowerCase();
---
<a
  href={`/${lang}/${basePath}/${slug}`}
  data-tool-card
  data-search-terms={searchTerms}
  class="tool-card group relative flex min-h-[280px] flex-col justify-between overflow-hidden rounded-3xl border border-gray-100 bg-white p-8 shadow-sm transition-all duration-500 hover:-translate-y-2 hover:border-purple-300 hover:shadow-2xl dark:border-gray-800 dark:bg-gray-800 dark:hover:border-purple-900/50"
>
  <div class="relative z-10">
    <div class="mb-6 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-purple-50 text-4xl shadow-inner transition-all duration-500 group-hover:scale-110 group-hover:bg-purple-600 group-hover:text-white dark:bg-purple-900/20 dark:group-hover:bg-purple-600">
      {tool.icon}
    </div>
    <h3 class="mb-3 text-2xl font-extrabold tracking-tight text-gray-900 transition-colors group-hover:text-purple-600 dark:text-gray-100 dark:group-hover:text-purple-400">
      {title}
    </h3>
    <p class="text-base leading-relaxed text-gray-500 transition-colors group-hover:text-gray-700 dark:text-gray-400 dark:group-hover:text-gray-300 line-clamp-3">
      {description}
    </p>
  </div>

  <div class="relative z-10 mt-8 flex items-center justify-between border-t border-gray-50 pt-6 dark:border-gray-700/50">
    <div class="flex items-center space-x-2">
      <span class="h-2 w-2 rounded-full bg-purple-500 animate-pulse"></span>
      <span class="text-xs font-bold uppercase tracking-widest text-purple-700 dark:text-purple-400">
        {category}
      </span>
    </div>
    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-50 text-gray-400 transition-all duration-300 group-hover:bg-purple-600 group-hover:text-white dark:bg-gray-700/50">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
      </svg>
    </span>
  </div>

  {/* Background Decorative Gradient */}
  <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-gradient-to-br from-purple-100/40 to-transparent transition-all duration-700 group-hover:scale-150 dark:from-purple-900/10"></div>
</a>
