---
import { tools } from '../data/tools';

const { lang } = Astro.props;
const { pathname } = Astro.url;

const allLangs = ['en', 'pt', 'es', 'fr', 'de', 'ru'] as const;
type LangCode = typeof allLangs[number];

const langLabels: Record<LangCode, string> = { en: 'EN', pt: 'PT', es: 'ES', fr: 'FR', de: 'DE', ru: 'RU' };
const langNames: Record<LangCode, string> = { en: 'English', pt: 'Português', es: 'Español', fr: 'Français', de: 'Deutsch', ru: 'Русский' };

const basePathMap: Record<LangCode, string> = {
  en: 'tools',
  pt: 'ferramentas',
  es: 'herramientas',
  fr: 'outils',
  de: 'werkzeuge',
  ru: 'instrumenty',
};

const pageSlugs: Record<string, Record<LangCode, string>> = {
  sobre:    { en: 'about', pt: 'sobre', es: 'sobre', fr: 'a-propos', de: 'ueber-uns', ru: 'o-nas' },
  about:    { en: 'about', pt: 'sobre', es: 'sobre', fr: 'a-propos', de: 'ueber-uns', ru: 'o-nas' },
  'politica-privacidade': { en: 'privacy-policy', pt: 'politica-privacidade', es: 'politica-privacidad', fr: 'politique-confidentialite', de: 'datenschutzrichtlinie', ru: 'politika-konfidencialnosti' },
  'privacy-policy': { en: 'privacy-policy', pt: 'politica-privacidade', es: 'politica-privacidad', fr: 'politique-confidentialite', de: 'datenschutzrichtlinie', ru: 'politika-konfidencialnosti' },
  feedback: { en: 'feedback', pt: 'feedback', es: 'feedback', fr: 'retour', de: 'feedback', ru: 'obratnaya-svyaz' },
  apoie:    { en: 'support', pt: 'apoie', es: 'apoyar', fr: 'soutenir', de: 'unterstuetzen', ru: 'podderzhat' },
  support:  { en: 'support', pt: 'apoie', es: 'apoyar', fr: 'soutenir', de: 'unterstuetzen', ru: 'podderzhat' },
};

const getTargetPath = (targetLang: LangCode): string => {
  if (targetLang === lang) return '#';

  const parts = pathname.split('/').filter(Boolean);
  const currentLang = parts[0] as LangCode;

  // Tool page: [lang]/[toolsBase]/[slug]
  if (parts.length >= 3 && allLangs.includes(currentLang)) {
    const currentSlug = parts[2];
    const tool = tools.find(t => (Object.values(t.slugs) as string[]).includes(currentSlug));
    if (tool) {
      return `/${targetLang}/${basePathMap[targetLang]}/${tool.slugs[targetLang]}`;
    }
  }

  // Static page: [lang]/[slug]
  if (parts.length === 2 && allLangs.includes(currentLang)) {
    const slug = parts[1];
    if (pageSlugs[slug]) {
      return `/${targetLang}/${pageSlugs[slug][targetLang]}`;
    }
  }

  // Blog pages: /{lang}/blog(/...)
  if (parts.length >= 2 && parts[1] === 'blog') {
    return `/${targetLang}/blog${parts.length > 2 ? '/' + parts.slice(2).join('/') : ''}`;
  }

  // Fallback: strip current lang prefix, prepend target
  const pathWithoutLang = allLangs.some(l => pathname.startsWith(`/${l}`))
    ? '/' + parts.slice(1).join('/')
    : pathname;
  return `/${targetLang}${pathWithoutLang}`;
};
---

<div class="flex items-center space-x-1 border border-gray-300 dark:border-gray-600 rounded-full p-1" role="group" aria-label="Language selector">
  {allLangs.map((l) => (
    <a
      href={getTargetPath(l)}
      aria-label={`Switch to ${langNames[l]}`}
      aria-current={lang === l ? 'page' : undefined}
      class:list={[
        "px-2 py-1 text-xs font-medium rounded-full transition-colors",
        lang === l ? 'bg-purple-500 text-white cursor-default' : 'hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-600 dark:text-gray-400'
      ]}
    >
      {langLabels[l]}
    </a>
  ))}
</div>
