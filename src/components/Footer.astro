---
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: 'pt' | 'en';
}

const { lang = 'pt' } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="bg-gray-100 mt-12 py-6 dark:bg-gray-800 dark:border-t dark:border-gray-700">
  <div class="container mx-auto px-6 text-center text-gray-600 dark:text-gray-400">
    <p>&copy; {year} SLIT.IO. {t('footer.rights')}</p>
  </div>
</footer>
