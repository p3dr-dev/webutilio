---
import { useTranslations } from '../i18n/utils';
import { pageSlugs, type Language } from '../lib/slugs';

interface Props {
  lang?: Language;
}

const { lang = 'pt' } = Astro.props;
const t = useTranslations(lang);

const PIX_KEY = 'fe17002f-fd15-4a76-be58-b1bf811f799f';
const supportPageUrl = `/${lang}/${pageSlugs.support[lang]}`;
---

<div id="support-fab-container" class="fixed bottom-6 right-6 z-50">
  {/* Popover */}
  <div
    id="support-fab-popover"
    class="hidden absolute bottom-20 right-0 w-72 bg-white dark:bg-gray-800 rounded-xl shadow-2xl border border-gray-200 dark:border-gray-700 p-5 transition-all duration-200"
    role="dialog"
    aria-label={t('supportFab.title')}
  >
    <button
      id="support-fab-close"
      type="button"
      class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
      aria-label="Close"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="text-center mb-4">
      <div class="inline-flex items-center justify-center w-10 h-10 bg-purple-100 dark:bg-purple-900/30 rounded-full mb-2">
        <svg class="w-5 h-5 text-purple-600 dark:text-purple-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
        </svg>
      </div>
      <h3 class="font-bold text-gray-800 dark:text-white text-sm">{t('supportFab.title')}</h3>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">{t('supportFab.description')}</p>
    </div>

    <div class="space-y-2">
      {/* Ko-fi */}
      <a
        href="https://ko-fi.com/pedrosimoes"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 p-2.5 rounded-lg bg-[#FF5E5B]/5 hover:bg-[#FF5E5B]/10 border border-transparent hover:border-[#FF5E5B]/30 transition-all group"
      >
        <span class="w-8 h-8 flex items-center justify-center rounded-full bg-white text-[#FF5E5B] font-bold text-sm shadow-sm">☕</span>
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover:text-[#FF5E5B] transition-colors">{t('supportFab.kofi')}</span>
      </a>

      {/* PIX */}
      <button
        type="button"
        id="support-fab-pix"
        data-pix={PIX_KEY}
        class="flex items-center gap-3 p-2.5 rounded-lg bg-green-50 dark:bg-green-900/10 hover:bg-green-100 dark:hover:bg-green-900/20 border border-transparent hover:border-green-300 dark:hover:border-green-700 transition-all group w-full text-left"
      >
        <span class="w-8 h-8 flex items-center justify-center rounded-full bg-green-500 text-white font-bold text-sm shadow-sm">R$</span>
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">{t('supportFab.pix')}</span>
      </button>

      {/* PayPal */}
      <a
        href="https://www.paypal.com/donate/?business=VTA8G22Q4EM3N&no_recurring=0&currency_code=BRL"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-3 p-2.5 rounded-lg bg-[#0070BA]/5 hover:bg-[#0070BA]/10 border border-transparent hover:border-[#0070BA]/30 transition-all group"
      >
        <span class="w-8 h-8 flex items-center justify-center rounded-full bg-white text-[#0070BA] font-bold text-sm shadow-sm">P</span>
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover:text-[#0070BA] transition-colors">{t('supportFab.paypal')}</span>
      </a>
    </div>

    {/* View all link */}
    <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-700 text-center">
      <a
        href={supportPageUrl}
        class="text-sm font-medium text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 transition-colors"
      >
        {t('supportFab.viewAll')} →
      </a>
    </div>
  </div>

  {/* FAB Button */}
  <button
    type="button"
    id="support-fab-btn"
    class="bg-purple-600 text-white rounded-full w-14 h-14 shadow-lg hover:bg-purple-700 transition-all hover:scale-110 flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
    aria-label={t('supportFab.openLabel')}
  >
    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
    </svg>
  </button>
</div>

<script is:inline define:vars={{ pixKey: PIX_KEY, copiedText: t('supportFab.copied') }}>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('support-fab-btn');
    const popover = document.getElementById('support-fab-popover');
    const closeBtn = document.getElementById('support-fab-close');
    const pixBtn = document.getElementById('support-fab-pix');

    if (!btn || !popover) return;

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      popover.classList.toggle('hidden');
    });

    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      popover.classList.add('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!popover.contains(e.target) && e.target !== btn) {
        popover.classList.add('hidden');
      }
    });

    pixBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pixKey);
        const span = pixBtn.querySelector('span:last-child');
        if (span) {
          const original = span.textContent;
          span.textContent = copiedText;
          span.classList.add('text-green-600');
          setTimeout(() => {
            span.textContent = original;
            span.classList.remove('text-green-600');
          }, 2000);
        }
      } catch {
        // clipboard not available
      }
    });
  });
</script>
